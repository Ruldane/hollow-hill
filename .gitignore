# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# local agent + design tooling output
/.playwright-mcp/
/.shots/
/.impeccable/
.claude/settings.local.json

# os / editor
.DS_Store
Thumbs.db
*.pem
.idea/
